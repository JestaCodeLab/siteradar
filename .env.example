# --- required ---
DATABASE_URL=postgresql://user:pass@host:5432/db
SECRET_KEY=change-me-long-random-string            # signs login cookies
APP_URL=https://monitor.upplauseconsulting.com     # the Next.js site (links in emails, Paystack callback)
ADMIN_EMAIL=you@upplauseconsulting.com             # first super admin
ADMIN_PASSWORD=choose-a-strong-one                 # used only when that account does not exist yet
SUPER_ADMIN_EMAILS=you@upplauseconsulting.com      # anyone listed here becomes super admin when they verify their email

# --- email (Resend) ---
RESEND_API_KEY=re_xxx
MAIL_FROM=SiteRadar <no-reply@upplauseconsulting.com>   # a domain verified in Resend
CONTACT_TO=hello@upplauseconsulting.com                 # where the Contact form goes

# --- files (Cloudinary): leave empty to keep files on local disk (development only) ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- payments (Paystack). For local testing without Paystack set BILLING_TEST_MODE=1 ---
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_SUBACCOUNT=ACCT_xxx          # optional: settle payments to this subaccount
PAYSTACK_FEE_BEARER=account           # account = we pay Paystack fees, subaccount = the subaccount does

# --- SMS (FlockText): API key from Settings -> Developer; sender ID optional (must be approved) ---
FLOCKTEXT_API_KEY=flk_live_xxx
FLOCKTEXT_SENDER_ID=
PAGESPEED_API_KEY=
TZ=Africa/Accra
